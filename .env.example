# Copy to .env and adjust for this VPS. JWT_SECRET is REQUIRED (compose
# refuses to start without it); everything else has a sane default baked
# into docker-compose.yml.

# Required. Signs demo-session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Demo sessions expire after this.
DEMO_TOKEN_TTL=2h

# Where the API container can reach the Ollama instance already running on
# this VPS (outside Docker). host.docker.internal is correct for the default
# setup described in the README; change it only if Ollama is bound to a
# specific interface or a non-default port.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3:8b

QDRANT_COLLECTION=rag_documents

# 15MB
MAX_UPLOAD_BYTES=15728640
# 1 hour
DOCUMENT_TTL_MS=3600000

CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40

# How many generations run at once, and how many more may wait behind them
# before new requests are rejected with "at capacity". Tune MAX_CONCURRENT_INFERENCE
# down if this VPS also runs the other two demos (router, MCP agent) against
# the same Ollama instance.
MAX_CONCURRENT_INFERENCE=2
MAX_QUEUE_LENGTH=20

# Per-IP rate limit: RATE_LIMIT_LIMIT requests per RATE_LIMIT_TTL_MS window.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=10

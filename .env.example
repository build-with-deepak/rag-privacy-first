# Copy to .env and adjust for this VPS. Everything here has a sane default
# baked into docker-compose.yml; nothing in this file is a secret any more,
# because this service no longer signs tokens — it only verifies them.

# Identity. This service no longer signs anything — it verifies tokens issued
# by id.build-with-deepak.com against that service's published JWKS, so there
# is deliberately no secret here to leak. See apps/api/src/auth/jwt-auth.guard.ts.
IDENTITY_ISSUER=https://id.build-with-deepak.com
IDENTITY_JWKS_URL=https://id.build-with-deepak.com/.well-known/jwks.json
IDENTITY_AUDIENCE=rag.build-with-deepak.com

# Where the API container can reach the Ollama instance already running on
# this VPS (outside Docker). host.docker.internal is correct for the default
# setup described in the README; change it only if Ollama is bound to a
# specific interface or a non-default port.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3:8b

QDRANT_COLLECTION=rag_documents

# 15MB
MAX_UPLOAD_BYTES=15728640
# 1 hour
DOCUMENT_TTL_MS=3600000

CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40

# How many generations run at once, and how many more may wait behind them
# before new requests are rejected with "at capacity". Tune MAX_CONCURRENT_INFERENCE
# down if this VPS also runs the other two demos (router, MCP agent) against
# the same Ollama instance.
MAX_CONCURRENT_INFERENCE=2
MAX_QUEUE_LENGTH=20

# Per-IP rate limit: RATE_LIMIT_LIMIT requests per RATE_LIMIT_TTL_MS window.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=10
